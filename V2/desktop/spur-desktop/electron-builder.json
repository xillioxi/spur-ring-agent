{
  "appId": "com.spur.ringdesktop", "productName": "Spur Desktop", "asar": true,
  "afterPack": "./scripts/collect-notices.mjs",
  "directories": { "output": "release" },
  "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
  "extraResources": [{ "from": "resources/ring-service", "to": "ring-service" }],
  "win": { "target": "dir", "signAndEditExecutable": false, "artifactName": "Spur-Desktop-${version}-${arch}.${ext}" },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.productivity",
    "minimumSystemVersion": "13.0",
    "artifactName": "Spur-Desktop-${version}-macOS-${arch}.${ext}",
    "hardenedRuntime": true,
    "entitlements": "build/macos/entitlements.mac.plist",
    "entitlementsInherit": "build/macos/entitlements.mac.inherit.plist",
    "notarize": false,
    "binaries": ["Contents/Resources/ring-service/SpurRingService.app/Contents/MacOS/SpurRingService"],
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Spur uses your computer microphone for live dictation only when you start a session or press your armed ring.",
      "NSBluetoothAlwaysUsageDescription": "Spur uses Bluetooth to connect to your ring, receive its controls, and download your recordings.",
      "NSBluetoothPeripheralUsageDescription": "Spur uses Bluetooth to connect to your ring and receive recordings and controls."
    }
  },
  "dmg": {
    "title": "Spur Desktop",
    "backgroundColor": "#F5F7F7",
    "window": { "width": 540, "height": 360 },
    "iconSize": 96,
    "contents": [
      { "x": 145, "y": 165, "type": "file" },
      { "x": 395, "y": 165, "type": "link", "path": "/Applications" }
    ]
  }
}
